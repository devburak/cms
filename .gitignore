# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/scripts

# misc
.DS_Store

.env.local
.env.development.local
.env.test.local
.env.production.local
.env*
.vscode

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Note: .env.development and .env.production are NOT ignored
# They contain non-sensitive configuration and should be committed
# Only .env.local and .env*.local are ignored for local overrides